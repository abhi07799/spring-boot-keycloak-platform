# Local development only. Copy this file to .env and replace every placeholder.
# Never commit .env or real credentials.

# Application PostgreSQL
APP_DB_NAME=platform
APP_DB_USER=platform
APP_DB_PASSWORD=replace-with-a-strong-local-password
APP_DB_PORT=5433

# Keycloak PostgreSQL (independent database and credentials)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-another-strong-local-password
KEYCLOAK_DB_PORT=5434

# Keycloak local bootstrap administrator
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password
KEYCLOAK_HTTP_PORT=8081
